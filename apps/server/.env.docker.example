# Copy to apps/server/.env and fill in the Google values.
# This file is loaded by docker compose and is not copied into the image.
DATABASE_URL=file:/data/local.db
CORS_ORIGIN=http://localhost:3002
PORT=3300
NODE_ENV=development

GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3300/oauth/google/callback
GOOGLE_ALLOWED_DOMAIN=test.invalid
ALLOW_ANY_VERIFIED_GOOGLE_ACCOUNT=true

TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64url-key
MCP_GATEWAY_KEY=replace-with-long-random-mcp-key
